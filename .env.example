# Copy this file to .env.local and fill in the values.
# Both the Next.js app and the Telegram bot read .env.local.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/tasktrack

# Long random string used to sign login sessions
JWT_SECRET=change-me-to-a-long-random-string

# Set to "false" to stop new sign-ups (the first account is always allowed and becomes admin)
ALLOW_REGISTRATION=true

# Comma-separated emails that are always admin, and the only ones that can be. They can sign up even when
# registration is closed. Leave empty to make the first account admin instead.
ADMIN_EMAILS=

# Google sign-in (optional). Create an OAuth client (Web application) in Google Cloud Console and add
# <APP_URL>/api/auth/google/callback as an Authorized redirect URI. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the site, used to build the Google redirect URI (defaults to the request's origin)
APP_URL=http://localhost:3000

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @ (shown on the Profile page as a link)
TELEGRAM_BOT_USERNAME=


# AI: NVIDIA (build.nvidia.com) when NVIDIA_API_KEY is set, otherwise Groq
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ignore AI interpretations below this confidence (0..1)
AI_MIN_CONFIDENCE=0.6

# Not online this many minutes after the team's shift starts = absent that day (0 disables)
ABSENT_AFTER_MINUTES=120

# Timezone used to tell the AI what "today" / "Friday" means, and for EOD/EOW day boundaries
APP_TIMEZONE=Asia/Kolkata

# EOD / EOW reports posted by the bot into each team's group (times in APP_TIMEZONE)
REPORT_EOD_TIME=19:00
# Days that get an EOD post: 0 = Sunday … 6 = Saturday
REPORT_WORK_DAYS=1,2,3,4,5
# Day the EOW summary is posted (after that day's EOD)
REPORT_EOW_DAY=5
